[Unit]
Description=Cloudflare tunnel for ReceiptIQ
After=network-online.target receiptiq.service
Wants=network-online.target

[Service]
Type=simple
User=siresoft
WorkingDirectory=/home/siresoft/receiptiq
ExecStart=/home/siresoft/receiptiq/deploy/run-cloudflared.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
