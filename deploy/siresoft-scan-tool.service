[Unit]
Description=SireSoft Scan Tool Django application (Gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
User=siresoft
Group=siresoft
WorkingDirectory=/home/siresoft/siresoft-scan-tool
ExecStart=/home/siresoft/siresoft-scan-tool/deploy/run-app.sh
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
