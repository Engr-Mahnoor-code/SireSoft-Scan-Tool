[Unit]
Description=ngrok tunnel for SireSoft ReceiptIQ
After=network-online.target siresoft-receiptiq.service
Wants=network-online.target

[Service]
Type=simple
User=siresoft
WorkingDirectory=/home/siresoft/siresoft-receiptiq
ExecStart=/home/siresoft/siresoft-receiptiq/deploy/run-ngrok.sh
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
