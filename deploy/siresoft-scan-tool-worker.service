[Unit]
Description=SireSoft Scan Tool receipt extraction worker (Ollama)
# The worker survives Ollama being down, but starting after it avoids a
# pointless round of retries on every boot.
After=network-online.target ollama.service
Wants=network-online.target

[Service]
Type=simple
User=siresoft
Group=siresoft
WorkingDirectory=/home/siresoft/siresoft-scan-tool
ExecStart=/home/siresoft/siresoft-scan-tool/deploy/run-worker.sh
# The worker finishes the receipt in hand on SIGTERM; give a slow model room
# to land rather than leaving the row stuck in "processing".
KillSignal=SIGTERM
TimeoutStopSec=300
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
