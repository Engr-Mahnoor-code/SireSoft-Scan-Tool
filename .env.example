# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

DB_NAME=siresoft_receiptiq_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Local model (Ollama) — no API key, nothing leaves this host.
# OLLAMA_MODEL must be a vision model and must already be pulled:
#     ollama pull llama3.2-vision
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2-vision
# Seconds to allow for one receipt. A CPU-only host needs the larger end.
OLLAMA_TIMEOUT=900

# Server deployment (see deploy/README.md)
APP_PORT=8002
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=600
