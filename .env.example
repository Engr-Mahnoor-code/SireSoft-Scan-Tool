# Copy this file to .env and fill in real values. Never commit .env itself.

SECRET_KEY=change-me

# The admin account. Real values go in the server's .env only - never commit
# the password. After setting them run:  python manage.py ensure_admin
# The app's login takes the email; /admin/ takes the username.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@siresoft.com
ADMIN_PASSWORD=Siresoft2468

# Every receipt is deleted this many hours after it was uploaded. Receipts
# owned by the admin (staff) are kept.
USER_DATA_TTL_HOURS=24

DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost

# Password reset mail. Leave EMAIL_HOST empty to print reset links to the
# server console instead of sending them.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=SireSoft Scan Tool <no-reply@siresoft.com>

DB_NAME=siresoft_receiptiq_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Local model (Ollama) — no API key, nothing leaves this host.
# OLLAMA_MODEL must be a vision model and must already be pulled:
#     ollama pull qwen2.5vl:3b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b
# Seconds to allow for one receipt. A CPU-only host needs the larger end.
OLLAMA_TIMEOUT=900
# A receipt image costs thousands of tokens. Ollama defaults to 4096, which a
# full page overflows - the request then fails outright instead of degrading.
OLLAMA_NUM_CTX=8192
# Longest edge, in pixels, of the image sent to the model. This is the real
# guard on context size; raising it risks the overflow above.
MAX_IMAGE_EDGE=1400

# Server deployment (see deploy/README.md)
APP_PORT=9000
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=600
